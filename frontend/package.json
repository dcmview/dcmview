{
  "name": "dcmview-frontend",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "^20.19 || ^22.12 || >=24"
  },
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "check:svelte": "svelte-check --tsconfig ./tsconfig.json",
    "check:ts": "tsc --noEmit",
    "typecheck": "npm run check:svelte && npm run check:ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "generate:types": "cargo run --locked --example generate_api_types",
    "check:contracts": "cargo run --locked --example generate_api_types -- --check",
    "preview": "vite preview"
  },
  "devDependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@sveltejs/vite-plugin-svelte": "^6.2.4",
    "@testing-library/svelte": "^5.4.2",
    "happy-dom": "^20.14.5",
    "svelte": "^5.56.3",
    "svelte-check": "^4.4.6",
    "typescript": "^5.7.2",
    "vite": "^6.4.1",
    "vitest": "^3.2.4"
  }
}
