{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dcmview.local/schemas/viewer-report.schema.json",
  "title": "dcmview Viewer Compatibility Report",
  "type": "object",
  "required": [
    "viewer_report_schema_version",
    "generated_at",
    "suite_manifest_sha256",
    "viewer",
    "run",
    "results"
  ],
  "properties": {
    "viewer_report_schema_version": {"const": "0.1.0"},
    "generated_at": {"type": "string"},
    "suite_manifest_sha256": {"$ref": "#/$defs/sha256"},
    "artifact_identity": {"type": "object"},
    "viewer": {"$ref": "#/$defs/viewer"},
    "run": {"$ref": "#/$defs/run"},
    "results": {"type": "array", "items": {"$ref": "#/$defs/result"}},
    "summary": {"$ref": "#/$defs/summary"}
  },
  "additionalProperties": false,
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "status": {"enum": ["passed", "failed", "skipped", "timeout", "unavailable"]},
    "viewer": {
      "type": "object",
      "required": ["name", "command"],
      "properties": {
        "name": {"type": "string"},
        "version": {"type": ["string", "null"]},
        "command": {"type": "string"},
        "environment": {"type": "object", "additionalProperties": {"type": "string"}}
      },
      "additionalProperties": false
    },
    "run": {
      "type": "object",
      "required": ["started_at", "completed_at", "timeout_seconds"],
      "properties": {
        "started_at": {"type": "string"},
        "completed_at": {"type": ["string", "null"]},
        "timeout_seconds": {"type": "number", "minimum": 0}
      },
      "additionalProperties": false
    },
    "summary": {
      "type": "object",
      "required": ["passed", "failed", "skipped", "timeout", "unavailable"],
      "properties": {
        "passed": {"type": "integer", "minimum": 0},
        "failed": {"type": "integer", "minimum": 0},
        "skipped": {"type": "integer", "minimum": 0},
        "timeout": {"type": "integer", "minimum": 0},
        "unavailable": {"type": "integer", "minimum": 0}
      },
      "additionalProperties": false
    },
    "result": {
      "type": "object",
      "required": [
        "case_id", "path", "status", "file_open", "object_recognition",
        "metadata", "pixel_rendering", "timing", "errors", "warnings", "artifacts"
      ],
      "properties": {
        "case_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9_-]*(/[a-z0-9][a-z0-9_-]*)+$"},
        "path": {"type": "string"},
        "status": {"$ref": "#/$defs/status"},
        "file_open": {"$ref": "#/$defs/check"},
        "object_recognition": {"$ref": "#/$defs/check"},
        "metadata": {"$ref": "#/$defs/metadata"},
        "pixel_rendering": {"$ref": "#/$defs/pixel_rendering"},
        "timing": {"$ref": "#/$defs/timing"},
        "errors": {"type": "array", "items": {"$ref": "#/$defs/message"}},
        "warnings": {"type": "array", "items": {"$ref": "#/$defs/message"}},
        "artifacts": {"type": "array", "items": {"$ref": "#/$defs/artifact"}}
      },
      "additionalProperties": false
    },
    "check": {
      "type": "object",
      "required": ["status"],
      "properties": {
        "status": {"$ref": "#/$defs/status"},
        "message": {"type": ["string", "null"]}
      },
      "additionalProperties": false
    },
    "metadata": {
      "type": "object",
      "required": ["status", "extracted"],
      "properties": {
        "status": {"$ref": "#/$defs/status"},
        "extracted": {"type": "object", "additionalProperties": {"type": ["string", "number", "boolean", "null"]}},
        "message": {"type": ["string", "null"]}
      },
      "additionalProperties": false
    },
    "pixel_rendering": {
      "type": "object",
      "required": ["status"],
      "properties": {
        "status": {"$ref": "#/$defs/status"},
        "decoded_pixel_hash": {"type": ["string", "null"]},
        "normalized_preview_hash": {"type": ["string", "null"]},
        "message": {"type": ["string", "null"]}
      },
      "additionalProperties": false
    },
    "timing": {
      "type": "object",
      "required": ["open_ms", "render_ms", "total_ms"],
      "properties": {
        "open_ms": {"type": ["number", "null"], "minimum": 0},
        "render_ms": {"type": ["number", "null"], "minimum": 0},
        "total_ms": {"type": ["number", "null"], "minimum": 0}
      },
      "additionalProperties": false
    },
    "message": {
      "type": "object",
      "required": ["message"],
      "properties": {
        "code": {"type": ["string", "null"]},
        "message": {"type": "string"},
        "details": {"type": ["string", "null"]}
      },
      "additionalProperties": false
    },
    "artifact": {
      "type": "object",
      "required": ["kind", "path"],
      "properties": {
        "kind": {"enum": ["screenshot", "stdout", "stderr", "log", "other"]},
        "path": {"type": "string"},
        "sha256": {"anyOf": [{"$ref": "#/$defs/sha256"}, {"type": "null"}]}
      },
      "additionalProperties": false
    }
  }
}
